NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Clave pública de Web Push: Firebase → Configuración → Cloud Messaging → Certificados web push → Generar par de claves
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# reCAPTCHA v3 para App Check: Firebase → App Check → Apps → reCAPTCHA v3 (clave de sitio)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# "true" SOLO cuando las Cloud Functions estén desplegadas (plan Blaze). Con "false" (plan gratuito) el panel de
# gestión publica en el mapa y crea las notificaciones internas, y el clima se pide desde el navegador.
NEXT_PUBLIC_SERVER_FUNCTIONS=false
