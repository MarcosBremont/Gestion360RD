rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function role() { return request.auth.token.get('role', 'citizen'); }

    // Foto del ciudadano: solo en su carpeta, imagen < 5 MB
    match /reports/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // La foto del ciudadano es privada: solo su dueño y el personal. Su URL vive únicamente en
      // reports/{id} (privado) y nunca se copia a publicReports.
      allow read: if request.auth != null
        && (request.auth.uid == uid || role() in ['admin', 'brigade', 'editor']);
    }
    // Evidencia del trabajo terminado
    match /evidence/{reportId}/{file} {
      allow write: if request.auth != null && (role() == 'admin' || role() == 'brigade')
        && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }
    // Contenido turístico
    match /content/{path=**} {
      allow write: if request.auth != null && (role() == 'editor' || role() == 'admin')
        && request.resource.size < 8 * 1024 * 1024;
      allow read: if true;
    }
  }
}
